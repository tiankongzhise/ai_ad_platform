# EduAdCRM Backend Environment Configuration Example

# ==================== 应用基础 ====================
APP_NAME=EduAdCRM
APP_VERSION=1.0.0
DEBUG=false

# ==================== 数据库 (MySQL) ====================
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/eduadcrm
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== JWT 认证 ====================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==================== 巨量引擎 OAuth (必须配置) ====================
# 申请地址: https://open.oceanengine.com/
JULIANG_APP_ID=your_juliang_app_id
JULIANG_APP_SECRET=your_juliang_app_secret
JULIANG_CALLBACK_URL=https://your-domain.com/api/v1/ad/juliang/callback

# ==================== 百度营销 OAuth (可选) ====================
BAIDU_APP_ID=your_baidu_app_id
BAIDU_APP_SECRET=your_baidu_app_secret
BAIDU_CALLBACK_URL=https://your-domain.com/api/v1/ad/baidu/callback

# ==================== 文件存储 ====================
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# ==================== 邮件 (可选) ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ==================== 限流 ====================
RATE_LIMIT_PER_MINUTE=60
